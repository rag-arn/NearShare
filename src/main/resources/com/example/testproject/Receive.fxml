<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.testproject.MainController">
    <children>
        <AnchorPane maxWidth="Infinity" maxHeight="Infinity">
            <children>

                <HBox alignment="CENTER_LEFT" AnchorPane.leftAnchor="40.0" AnchorPane.topAnchor="35.0">
                    <children>
                        <ImageView fitHeight="28.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@Logo2.png" /></image>
                        </ImageView>
                    </children>
                </HBox>

                <VBox alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
                    <children>

                        <Label styleClass="sub-header-tagline" text="FAST   •   SECURE   •   SEAMLESS" />

                        <ImageView fitHeight="180.0" fitWidth="450.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@Logo2.png" /></image>
                        </ImageView>

                        <Label styleClass="footer-tagline" text="Share files. Stay close." />

                        <VBox alignment="CENTER" maxWidth="550.0" prefWidth="550.0" spacing="30.0" styleClass="glass-card">
                            <VBox.margin>
                                <Insets top="20.0" />
                            </VBox.margin>
                            <children>

                                <ToggleButton fx:id="receiveToggle" mnemonicParsing="false" prefHeight="70.0" prefWidth="480.0" styleClass="primary-pill-toggle" text="Receiver Mode">
                                    <graphic>
                                        <ImageView fitHeight="24.0" fitWidth="24.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true">
                                            <image><Image url="@receive.png" /></image>
                                        </ImageView>
                                    </graphic>
                                </ToggleButton>

                                <VBox alignment="CENTER" spacing="10.0">
                                    <children>

                                        <HBox alignment="CENTER" minHeight="70.0" spacing="10.0">
                                            <children>
                                                <ImageView fx:id="loadingAnimation" blendMode="SCREEN" fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                                                    <image><Image url="@loading.gif" /></image>
                                                </ImageView>

                                                <Label fx:id="receiveStatusLabel" styleClass="status-text" text="Listening for files..." />
                                            </children>
                                        </HBox>

                                        <ProgressBar fx:id="receiveProgressBar" prefHeight="8.0" prefWidth="450.0" progress="0.0" visible="false" />
                                    </children>
                                </VBox>

                                <Button mnemonicParsing="false" onAction="#goToSendScene" prefHeight="70.0" prefWidth="480.0" styleClass="secondary-pill-button" text="Switch to Send Mode">
                                    <graphic>
                                        <ImageView fitHeight="24.0" fitWidth="24.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true">
                                            <image><Image url="@send.png" /></image>
                                        </ImageView>
                                    </graphic>
                                </Button>

                            </children>
                        </VBox>

                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="15.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="35.0">
                    <children>
                        <Button fx:id="historyButton" mnemonicParsing="false" onAction="#onHistoryButtonClicked" styleClass="circular-icon-button">
                            <graphic><ImageView fitHeight="24.0" fitWidth="24.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true"><image><Image url="@history.png" /></image></ImageView></graphic>
                        </Button>
                        <Button fx:id="profileButton" mnemonicParsing="false" onAction="#onProfileButtonClicked" styleClass="circular-icon-button">
                            <graphic><ImageView fitHeight="24.0" fitWidth="24.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true"><image><Image url="@icon.png" /></image></ImageView></graphic>
                        </Button>
                    </children>
                </HBox>

            </children>
        </AnchorPane>
    </children>
</StackPane>