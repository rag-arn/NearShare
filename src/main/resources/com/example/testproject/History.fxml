<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.testproject.MainController">
    <children>
        <AnchorPane maxWidth="Infinity" maxHeight="Infinity">
            <children>


                <HBox alignment="CENTER_LEFT" AnchorPane.leftAnchor="40.0" AnchorPane.topAnchor="35.0">
                    <children>
                        <ImageView fitHeight="28.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@Logo2.png" /></image>
                        </ImageView>
                    </children>
                </HBox>


                <VBox alignment="CENTER" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
                    <children>


                        <VBox alignment="CENTER" maxWidth="1000.0" prefWidth="1000.0" spacing="25.0" styleClass="glass-card">
                            <children>

                                <AnchorPane>
                                    <children>
                                        <Label alignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" style="-fx-text-fill: #FFFFFF; -fx-font-size: 24px; -fx-font-weight: bold;" text="Transfer History" />
                                        <HBox spacing="15.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" alignment="CENTER">
                                            <children>
                                                <Button fx:id="importHistoryButton" mnemonicParsing="false" onAction="#onImportHistoryClicked" styleClass="circular-icon-button">
                                                    <graphic><ImageView fitHeight="24.0" fitWidth="24.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true"><image><Image url="@import.png" /></image></ImageView></graphic>
                                                </Button>
                                                <Button fx:id="exportHistoryButton" mnemonicParsing="false" onAction="#onExportHistoryClicked" styleClass="circular-icon-button">
                                                    <graphic><ImageView fitHeight="24.0" fitWidth="24.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true"><image><Image url="@export.png" /></image></ImageView></graphic>
                                                </Button>
                                            </children>
                                        </HBox>
                                    </children>
                                </AnchorPane>


                                <TableView fx:id="historyTableView" minHeight="350.0" prefHeight="350.0" maxHeight="350.0">
                                    <columns>
                                        <TableColumn fx:id="colSerial" prefWidth="80.0" text="Serial" />
                                        <TableColumn fx:id="colFileName" prefWidth="380.0" text="File Name" />
                                        <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                                        <TableColumn fx:id="colDate" prefWidth="160.0" text="Date" />
                                        <TableColumn fx:id="colTime" prefWidth="160.0" text="Time" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <VBox.margin>
                                        <Insets top="10.0" bottom="10.0" />
                                    </VBox.margin>
                                </TableView>


                                <HBox spacing="20.0" alignment="CENTER">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#goToReceiveScene" minHeight="55.0" prefHeight="55.0" prefWidth="350.0" styleClass="primary-action-button" text="Switch to Receiver Mode">
                                            <graphic>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true">
                                                    <image><Image url="@receive.png" /></image>
                                                </ImageView>
                                            </graphic>
                                        </Button>


                                        <Button mnemonicParsing="false" onAction="#onClearHistoryClicked" minHeight="55.0" prefHeight="55.0" prefWidth="350.0" styleClass="secondary-pill-button" text="Clear History" />
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                    </children>
                </VBox>

            </children>
        </AnchorPane>
    </children>
</StackPane>