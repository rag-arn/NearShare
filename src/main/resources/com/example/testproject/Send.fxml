<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.testproject.MainController">
    <children>
        <AnchorPane maxHeight="Infinity" maxWidth="Infinity">
            <children>

                <HBox alignment="CENTER_LEFT" AnchorPane.leftAnchor="40.0" AnchorPane.topAnchor="35.0">
                    <children>
                        <ImageView fitHeight="28.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@Logo2.png" /></image>
                        </ImageView>
                    </children>
                </HBox>

                <!-- Top Right Icons Removed -->

                <VBox alignment="CENTER" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
                    <children>

                        <!-- Wider Glass Card -->
                        <VBox alignment="CENTER" maxWidth="960.0" prefWidth="960.0" spacing="20.0" styleClass="glass-card">
                            <children>

                                <HBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                            <image><Image url="@send.png" /></image>
                                        </ImageView>
                                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" text="Send Mode" />
                                    </children>
                                </HBox>

                                <!-- File & Peer Selection -->
                                <HBox alignment="TOP_CENTER" spacing="50.0">
                                    <children>

                                        <!-- Left Column: Files (Pushed down via margin, wider) -->
                                        <VBox prefWidth="420.0" spacing="15.0">
                                            <children>
                                                <Label styleClass="status-text" text="Selected Files" />
                                                <ListView fx:id="fileListView" maxHeight="300.0" minHeight="260.0" prefHeight="267.0" prefWidth="420.0">
                                                    <VBox.margin>
                                                        <!-- Lowers the Selected Files box -->
                                                        <Insets top="35.0" />
                                                    </VBox.margin>
                                                </ListView>
                                                <HBox alignment="CENTER" spacing="15.0">
                                                    <children>
                                                        <!-- Smaller Add/Remove buttons -->
                                                        <Button fx:id="selectFilesButton" onAction="#onSelectFilesButtonClicked" prefHeight="36.0" prefWidth="140.0" styleClass="secondary-pill-button" text="+ Add" />
                                                        <Button fx:id="removeFileButton" onAction="#onRemoveFileClicked" prefHeight="36.0" prefWidth="140.0" styleClass="secondary-pill-button" text="- Remove" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- Right Column: Devices (Trimmed from bottom, wider) -->
                                        <VBox prefWidth="420.0" spacing="15.0">
                                            <children>
                                                <Label styleClass="status-text" text="Available Devices" />
                                                <!-- Shorter height to trim the bottom compared to the Left column -->
                                                <TabPane fx:id="sendModeTabPane" maxHeight="300.0" minHeight="300.0" prefHeight="300.0" tabClosingPolicy="UNAVAILABLE">
                                                    <tabs>
                                                        <Tab text="One">
                                                            <content><ListView fx:id="peerListViewOne" /></content>
                                                        </Tab>
                                                        <Tab text="Many">
                                                            <content><ListView fx:id="peerListViewMany" /></content>
                                                        </Tab>
                                                        <Tab text="All">
                                                            <content><ListView fx:id="peerListViewAll" /></content>
                                                        </Tab>
                                                    </tabs>
                                                </TabPane>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox alignment="CENTER" spacing="8.0">
                                    <children>
                                        <HBox alignment="CENTER" spacing="10.0">
                                            <children>
                                                <Circle radius="5.0" styleClass="status-dot" />
                                                <Label fx:id="sendStatusLabel" styleClass="status-text" text="Ready to send..." />
                                            </children>
                                        </HBox>
                                        <ProgressBar fx:id="sendProgressBar" prefHeight="8.0" prefWidth="500.0" progress="0.0" visible="false" />
                                    </children>
                                </VBox>

                                <!-- Smaller Main Action Buttons -->
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#goToReceiveScene" prefHeight="55.0" prefWidth="350.0" styleClass="secondary-pill-button" text="Switch to Receiver Mode">
                                            <graphic>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true">
                                                    <image><Image url="@receive.png" /></image>
                                                </ImageView>
                                            </graphic>
                                        </Button>
                                        <Button fx:id="sendFilesButton" mnemonicParsing="false" onAction="#onSendFilesButtonClicked" prefHeight="55.0" prefWidth="350.0" styleClass="primary-action-button" text="Send Files">
                                            <graphic>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true">
                                                    <image><Image url="@send.png" /></image>
                                                </ImageView>
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>
